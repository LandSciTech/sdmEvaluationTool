<mxfile host="app.diagrams.net">
  <diagram id="upload-ui-deployment" name="Upload UI deployment">
    <mxGraphModel dx="1220" dy="740" grid="0" page="1" pageScale="1" pageWidth="1220" pageHeight="740" background="#FFFFFF">
