          <mxGeometry x="24" y="20" width="1172" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Deploy data from a local workspace, or have two separate apps use the same data on a server." style="text;html=1;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="24" y="66" width="1172" height="24" as="geometry"/>
