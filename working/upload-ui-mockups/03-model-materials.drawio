                <mxCell id="metadata-example" parent="1" style="html=1;whiteSpace=wrap;fillColor=#F8F9FA;strokeColor=#DEE2E6;align=left;verticalAlign=top;spacing=14;fontSize=14;fontColor=#212529;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Model-level tabs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Predictor metadata (required)&lt;/b&gt;&lt;br&gt;[ Choose metadata table ] &amp;nbsp; [ Validate ]&lt;br&gt;&lt;br&gt;&lt;b&gt;Model metadata (required)&lt;/b&gt;&lt;br&gt;[ Open metadata tool ] &amp;nbsp; [ Upload and validate ]&lt;br&gt;Include required prediction map layer metadata.&lt;br&gt;&lt;br&gt;&lt;b&gt;Predictor raster (optional)&lt;/b&gt;&lt;br&gt;[ Choose raster ] &amp;nbsp; [ Validate ]&lt;br&gt;Resample if too large; report basic checks." vertex="1">
                    <mxGeometry height="245" width="418" x="24" y="678" as="geometry"/>
                </mxCell>
                <mxCell id="species-example" parent="1" style="html=1;whiteSpace=wrap;fillColor=#F8F9FA;strokeColor=#DEE2E6;align=left;verticalAlign=top;spacing=14;fontSize=14;fontColor=#212529;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Observations, Model summary, Model fit&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Species ID&lt;/b&gt; &amp;nbsp; [ BBWA : Bay-breasted Warbler &amp;#9662; ]&lt;br&gt;&lt;br&gt;Each tab: [ Choose table ] &amp;nbsp; [ Upload and validate ]&lt;br&gt;All three tables are required for the selected species.&lt;br&gt;&lt;br&gt;&lt;b&gt;Model summary and Model fit only&lt;/b&gt;&lt;br&gt;[ Use placeholder table ]&lt;br&gt;When using a summary placeholder, turn off the Model summary display in evaluations." vertex="1">
                    <mxGeometry height="245" width="436" x="462" y="678" as="geometry"/>
                </mxCell>
                <mxCell id="prediction-example" parent="1" style="html=1;whiteSpace=wrap;fillColor=#F8F9FA;strokeColor=#DEE2E6;align=left;verticalAlign=top;spacing=14;fontSize=14;fontColor=#212529;" value="&lt;b style=&#39;font-size:16px&#39;&gt;Spatial predictions (required)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Species with uploads:&lt;/b&gt; OVEN (2 layers)&lt;br&gt;&lt;b&gt;Species missing uploads:&lt;/b&gt; BBWA (0 layers)&lt;br&gt;&lt;br&gt;[ Species: BBWA &amp;#9662; ] &amp;nbsp; [ Choose multiple rasters ]&lt;br&gt;[ Upload and validate ]&lt;br&gt;&lt;br&gt;Match the layer IDs, resolution, and extent to validated map layer metadata. Upload is disabled until that metadata passes. Re-upload policy is open." vertex="1">
